# Environment Variables Template
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git!

# Supabase (for auth & data access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Production genome engine (optional)
# If set, the app will call the real backend instead of using the mock engine
# Leave unset for local dev (uses mock engine, no API costs)
# VITE_ENGINE_API_URL=https://engine.genomeai.space

# Optional: Analytics
# VITE_PLAUSIBLE_DOMAIN=genomeai.space
# VITE_ANALYTICS_ENDPOINT=https://...

# Waitlist (optional — see docs/WAITLIST.md)
# 1) Generic JSON webhook (Formspree, Make, custom API) — tried first
# VITE_WAITLIST_ENDPOINT=https://formspree.io/f/xxxxxxxx
# 2) Or use Supabase table `waitlist` with the SQL in docs/WAITLIST.md
# 3) Fallback: FormSubmit emails contact@genomeai.space
