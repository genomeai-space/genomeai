# Environment Variables Template
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git!

# Supabase (for auth & data access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Production genome engine (optional)
# If set, the app will call the real backend instead of using the mock engine
# Leave unset for local dev (uses mock engine, no API costs)
# VITE_ENGINE_API_URL=https://engine.genomeai.space

# Optional: Analytics
# VITE_PLAUSIBLE_DOMAIN=genomeai.space
